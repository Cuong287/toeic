rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: tạo tay trong Console, admin hoặc chính chủ đọc được để kiểm tra quyền
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Bảng xếp hạng: công khai để mọi người xem, người dùng tự cập nhật tổng điểm của chính mình
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'totalBest', 'completedCount', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.totalBest is number && request.resource.data.totalBest >= 0 && request.resource.data.totalBest <= 4500
        && request.resource.data.completedCount is number && request.resource.data.completedCount >= 0 && request.resource.data.completedCount <= 45;
      allow delete: if isOwner(uid);
    }

    // Dữ liệu người dùng
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'email', 'hidden', 'createdAt', 'updatedAt'])
        && (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80)
        && (request.resource.data.email is string && request.resource.data.email.size() <= 120)
        && (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 800)
        && (request.resource.data.hidden is bool);

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'hidden', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'permissions']))
        && (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80)
        && (request.resource.data.email is string && request.resource.data.email.size() <= 120)
        && (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 800)
        && (request.resource.data.hidden is bool);

      allow delete: if isOwner(uid);

      // Tiến độ học theo chủ đề (điểm best 0-100, completed, completedManual)
      match /progress/{topicId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && (request.resource.data.best == null || (request.resource.data.best is number && request.resource.data.best >= 0 && request.resource.data.best <= 100))
          && (request.resource.data.completed == null || request.resource.data.completed is bool)
          && (request.resource.data.completedManual == null || request.resource.data.completedManual is bool);
        allow delete: if isOwner(uid);
      }

      // Câu trả lời và bản dịch của người dùng
      match /answers/{topicId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isOwner(uid);
      }

      // Metadata (từ khó cần ôn review...)
      match /meta/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isOwner(uid);
      }
    }
  }
}
